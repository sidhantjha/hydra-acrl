**/*.avi

# Negated parent directories also expose descendants unless explicitly excluded.
hydra_mapping/external
hydra_mapping/runs
hydra_mapping/*_ws/build
hydra_mapping/*_ws/install
hydra_mapping/*_ws/log
hydra_task_and_motion_planning/build
