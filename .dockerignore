# Only source used by a build stage enters the primary context.
**
!Dockerfile
!launch.sh
!THIRD_PARTY_NOTICES.md
!docker/
!docker/build.sh
!docker/entrypoint.sh
!hydra_mapping/
!hydra_mapping/hydra.repos
!hydra_mapping/scripts/
!hydra_mapping/scripts/*.sh
!hydra_mapping/scripts/export_dsg.py
!hydra_mapping/hydra_ws/
!hydra_mapping/hydra_ws/colcon_defaults.yaml
!hydra_mapping/hydra_ws/src/
!hydra_mapping/hydra_ws/src/**
!hydra_mapping/tb3_ws/
!hydra_mapping/tb3_ws/src/
!hydra_mapping/tb3_ws/src/**
!hydra_task_and_motion_planning/
!hydra_task_and_motion_planning/setup.sh
!hydra_task_and_motion_planning/pyproject.toml
!hydra_task_and_motion_planning/requirements.txt
!hydra_task_and_motion_planning/src/
!hydra_task_and_motion_planning/src/**
!hydra_task_and_motion_planning/scripts/
!hydra_task_and_motion_planning/scripts/*.py
!hydra_task_and_motion_planning/tests/
!hydra_task_and_motion_planning/tests/test_reference.py

# Kimera-RPGO is fetched in the build stage. Small House is a runtime mount.
hydra_mapping/hydra_ws/src/kimera_rpgo
hydra_mapping/small_house

**/.git
**/.github
**/.venv*
**/__pycache__
**/*.py[cod]
**/*.egg-info
